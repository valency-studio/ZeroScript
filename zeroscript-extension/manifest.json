{
  "manifest_version": 3,
  "name": "BetterScript Studio × Roblox Agent",
  "version": "1.0.3",
  "description": "BetterScript Studio — loop stability, ClickUp Brain2, done SFX, ForgeGUI/Make UI modes, advanced anim kits, macOS launcher.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*",
    "https://gemini.google.com/*",
    "https://www.kimi.com/*",
    "https://kimi.com/*",
    "https://chat.z.ai/*",
    "https://chat.qwen.ai/*",
    "https://arena.ai/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*",
    "https://grok.x.ai/*",
    "https://x.com/*",
    "https://copilot.microsoft.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://chat.mistral.ai/*",
    "https://poe.com/*",
    "https://huggingface.co/chat/*",
    "https://pi.ai/*",
    "https://you.com/*",
    "https://www.phind.com/*",
    "https://phind.com/*",
    "https://www.blackbox.ai/*",
    "https://blackbox.ai/*",
    "https://chat.lmsys.org/*",
    "https://lmarena.ai/*",
    "https://duck.ai/*",
    "https://api.github.com/*",
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*",
    "https://console.groq.com/*",
    "https://aistudio.google.com/*",
    "https://openrouter.ai/*",
    "https://coral.cohere.com/*",
    "https://t3.chat/*",
    "https://chat.together.ai/*",
    "https://api.together.xyz/*",
    "https://v0.dev/*",
    "https://app.clickup.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BetterScript Free",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/chatgpt.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/claude.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
